# macOS
.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp

# Env / secrets (never commit)
# .env and all variants are excluded; only .env.example (documentation, no real values) is tracked.
# secrets/ is a local-only directory for any scratch key material.
.env
.env.*
!.env.example
*.local
secrets/

# Build outputs
dist/
.astro/

# Lighthouse report (build output of `pnpm lh`; budgets file IS committed)
perf/.lh-report.json

# Avatar index artifacts (deploy-time; real ones need EMBEDDINGS_API_KEY)
public/avatar-index.json
.avatar-index/

# Dependencies
node_modules/

# Test artifacts
test-results/
playwright-report/
playwright/.cache/
.playwright-mcp/
coverage/

# Claude Code session data (auto-generated, not source)
.claude/

# Content-engine per-run working dirs (assembled slate + cpe state + artifacts)
pipeline/runs/

# Content-engine schedule runtime state (heartbeat/alerts ledgers, pause flag, cron log)
pipeline/schedule/state/

# Python tooling caches
__pycache__/
.pytest_cache/
.ruff_cache/
