# macOS
.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp

# Env / secrets (never commit)
# .env and all variants are excluded; only .env.example (documentation, no real values) is tracked.
# secrets/ is a local-only directory for any scratch key material.
.env
.env.*
!.env.example
*.local
secrets/

# Build outputs
dist/
.astro/

# Lighthouse report (build output of `pnpm lh`; budgets file IS committed)
perf/.lh-report.json

# Avatar index artifacts (deploy-time; real ones need EMBEDDINGS_API_KEY)
public/avatar-index.json
.avatar-index/

# Dependencies
node_modules/

# Test artifacts
test-results/
playwright-report/
playwright/.cache/
.playwright-mcp/
coverage/

# Claude Code session data (auto-generated, not source)
.claude/

# Content-engine per-run working dirs (assembled slate + cpe state + artifacts)
pipeline/runs/
pipeline/runs-radar/

# Content-engine schedule runtime state (heartbeat/alerts ledgers, pause flag, cron log)
pipeline/schedule/state/
pipeline/schedule/state-radar/

# uv-managed local virtualenv + lockfile (py3.14 pipeline toolchain via `uv run`)
.venv/
uv.lock

# Python tooling caches
__pycache__/
.pytest_cache/
.ruff_cache/

# Owner-only build scratch (purged from history before this repo went public).
# Raw agent planning dumps and the project inventory — superseded by the curated
# narrative in RUN-LOG.md. Paths are ANCHORED with a leading slash on purpose:
# the content engine writes its own per-run `plans/` under pipeline/runs*/, and
# an unanchored `plans/` would swallow those too.
/PROJECT-INVENTORY.md
/inventory/
/plans/
/plans-writing-rigor/
