# ─────────────────────────────────────────────────────────────────
# my-blog environment variables
# Copy to .env and fill in real values. Never commit .env.
# See docs/persona.md "Manual steps" for how to obtain each key.
# ─────────────────────────────────────────────────────────────────

# Avatar synthesis LLM — OpenRouter (https://openrouter.ai)
# Used by: functions/api/avatar/query.ts (Cloudflare Pages Function)
OPENROUTER_API_KEY=sk-or-REPLACE-WITH-YOUR-KEY

# Avatar multilingual embedder — OpenRouter or dedicated provider
# Used by: scripts/build-avatar-index.ts + functions/api/avatar/query.ts
EMBEDDINGS_API_KEY=REPLACE-WITH-YOUR-KEY

# Cloudflare Pages deployment — API token with Pages:Edit permission
# Used by: CI deploy step (.github/workflows/)
CLOUDFLARE_API_TOKEN=REPLACE-WITH-YOUR-TOKEN

# Cloudflare account ID (visible in the Cloudflare dashboard sidebar)
# Used by: CI deploy step (.github/workflows/)
CLOUDFLARE_ACCOUNT_ID=REPLACE-WITH-YOUR-ACCOUNT-ID

# Public site origin used for sitemap + RSS feed absolute URLs
SITE_URL=https://rachidchabane.dev
