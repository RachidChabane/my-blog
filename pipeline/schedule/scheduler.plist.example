<!-- my-blog content engine - scheduling (M-5). TWO LaunchAgents: save each
     as ~/Library/LaunchAgents/<Label>.plist and `launchctl load` it. Edit
     <REPO_ROOT>; times are LOCAL (reconciled to the UTC Cadence by run_id/
     calendar-day matching). The RUN agent carries the deploy env
     (PIPELINE_GIT_PUSH/_EMBEDDER/_MODEL); add ALERT_WEBHOOK_URL +
     UPTIME_PING_URL to its EnvironmentVariables for failure alerts. -->

<!-- 1/2 - RUN -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rachidchabane.myblog.run</string>
  <key>WorkingDirectory</key><string><REPO_ROOT></string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PIPELINE_GIT_PUSH</key><string>1</string>
    <key>PIPELINE_EMBEDDER</key><string>real</string>
    <key>PIPELINE_MODEL</key><string>opus</string>
    <key>PIPELINE_SOURCE_VERIFY</key><string>real</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>python3</string>
    <string>-m</string>
    <string>pipeline.schedule.cron</string>
    <string>run</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>9</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key><string><REPO_ROOT>/pipeline/schedule/state/cron.log</string>
  <key>StandardErrorPath</key><string><REPO_ROOT>/pipeline/schedule/state/cron.log</string>
</dict>
</plist>

<!-- 2/2 - MONITOR (dead-man's-switch) -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rachidchabane.myblog.monitor</string>
  <key>WorkingDirectory</key><string><REPO_ROOT></string>
  <key>ProgramArguments</key>
  <array>
    <string>python3</string>
    <string>-m</string>
    <string>pipeline.schedule.cron</string>
    <string>monitor</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>18</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key><string><REPO_ROOT>/pipeline/schedule/state/cron.log</string>
  <key>StandardErrorPath</key><string><REPO_ROOT>/pipeline/schedule/state/cron.log</string>
</dict>
</plist>
