---
/**
 * Fixed-corner avatar launcher SLOT (app-ia.md S10). NON-FIGURATIVE per D-007 —
 * an abstract 4×4 lattice ("maillage"), never a human likeness, character,
 * mascot, or living being.
 * INERT placeholder in task 6 (CSS-only, aria-hidden, no JS, no control
 * behavior). Task 20 mounts the interactive <Avatar/> island into this slot,
 * replaces the inner mark, drops aria-hidden, restores pointer-events, and uses
 * the localized chrome(lang).avatarAria label. Ports avatar.js's `is-static`
 * state (16 nodes; #6 and #11 emphasized) to pure CSS, tokens only.
 */
---

<div class="avatar-launcher" data-avatar-slot aria-hidden="true">
  <span class="avatar-mark">
    {Array.from({ length: 16 }).map(() => <b class="avatar-mark__node" />)}
  </span>
</div>

<style>
  /* container ~ design .rc-fab (60×60, radius-lg, surface, border-subtle, shadow-lg) */
  .avatar-launcher {
    position: fixed;
    right: var(--sp-5);
    bottom: var(--sp-5);
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    /* inert decorative placeholder — must NOT intercept corner clicks while
       inert; task 20 restores pointer-events on the interactive control. */
    pointer-events: none;
  }
  .avatar-mark {
    display: inline-grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    place-items: center;
    gap: 2px;
    width: 40px;
    height: 40px;
    padding: 6px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 13%, transparent);
  }
  .avatar-mark__node {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.62;
  }
  /* emphasized nodes — matches avatar.js `is-static` state */
  .avatar-mark__node:nth-child(6),
  .avatar-mark__node:nth-child(11) {
    opacity: 1;
  }
</style>
