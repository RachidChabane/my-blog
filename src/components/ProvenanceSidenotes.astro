---
/**
 * Grounded-citation sidenotes island (engagement Option B). Mounted on an article page ONLY
 * when a provenance entry exists for (slug, lang) -- so the seed corpus (no provenance) gets
 * nothing and every existing gate stays green. Renders no figure and no landmark: just a data
 * carrier <div> plus a hoisted module script that hands the article body + the citations to the
 * pure, unit-tested attachSidenotes (src/lib/avatar/sidenotes.ts). Citations cross into the
 * script via a data-* attribute (Astro HTML-escapes attribute values -- safe), never executable
 * scope; the island itself never uses a markup sink (textContent / DOM nodes only).
 */
import '@/styles/sidenotes.css';
import type { ProvenanceCitation } from '@/lib/avatar/sidenotes';

interface Props {
  citations: ProvenanceCitation[];
}
const { citations } = Astro.props;
---

{
  citations.length > 0 && (
    <div
      class="rc-sn-root"
      data-sn-root
      data-citations={JSON.stringify(citations)}
      hidden
    />
  )
}

<script>
  import { attachSidenotes } from '@/lib/avatar/sidenotes';
  import type { ProvenanceCitation } from '@/lib/avatar/sidenotes';

  // const arrow / no hoisted function decls inside the guard keeps TS narrowing
  // (astro-island-closure-narrowing). The island no-ops if either node is absent.
  const root = document.querySelector<HTMLElement>('[data-sn-root]');
  const body = document.querySelector<HTMLElement>('.rc-article__body');
  if (root && body) {
    const parse = (raw: string): ProvenanceCitation[] => {
      try {
        return JSON.parse(raw) as ProvenanceCitation[];
      } catch {
        return [];
      }
    };
    attachSidenotes(body, parse(root.dataset.citations ?? '[]'));
  }
</script>
