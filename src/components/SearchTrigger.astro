---
/**
 * SearchTrigger — search affordance in the masthead. INERT in task 6: a
 * <button data-search-trigger> with no behavior. Task 15 wires it to open S9
 * (/[lang]/search/) or an inline overlay. The design's ⌘K hint is intentionally
 * omitted (mac-specific glyph; a shortcut that does nothing until task 15 would
 * mislead). Lucide search glyph inline as SVG (INV-9). Ports design .rc-search.
 */
import type { Locale } from '@/i18n/index';
import { chrome } from '@/i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const c = chrome(lang);
---

<button
  type="button"
  class="search-trigger"
  data-search-trigger
  aria-label={c.searchLabel}
>
  <svg
    class="search-trigger__icon"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span class="search-trigger__label">{c.searchLabel}</span>
</button>

<style>
  /* Ported from design .rc-search (screens.css) — tokens only. */
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 36px;
    padding: 0 10px 0 12px;
    border-radius: var(--radius);
    border: 1px solid var(--border-subtle);
    background: var(--surface);
    color: var(--fg-subtle);
    transition:
      border-color var(--dur-hover) var(--ease-soft),
      color var(--dur-hover) var(--ease-soft);
  }
  .search-trigger:hover {
    border-color: var(--border);
    color: var(--fg-muted);
  }
  .search-trigger:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-ring);
    color: var(--fg-muted);
  }
  .search-trigger__label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  /* Collapse to an icon-only affordance on narrow viewports (design parity). */
  @media (max-width: 1180px) {
    .search-trigger {
      padding: 0;
      width: 36px;
      justify-content: center;
    }
    .search-trigger__label {
      display: none;
    }
  }
</style>
