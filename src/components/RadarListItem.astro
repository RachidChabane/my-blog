---
/**
 * RadarListItem — one row in the Radar feed (/[lang]/radar/). The radar analog of
 * ArticleListItem: same `.rc-arow*` markup + signature accent-spine row-hover so it
 * is visually identical to the article list, with two deliberate differences for a
 * short dated brief: the meta row leads with the date + a localized KIND label
 * (instead of reading-time + difficulty stars), and the tag pills are plain labels
 * (radar tags are not wired to the article tag pages). Renders a RadarCard
 * view-model (built in src/lib/content.ts). No nested <a>: the title is the sole
 * link; the "Read →" CTA is a decorative aria-hidden span. Tokens only.
 */
import type { RadarCard } from '@/lib/content';

interface Props {
  card: RadarCard;
  readCta: string;
  reveal?: boolean; // opt the row into the scroll-reveal (data-reveal); see src/lib/reveal.ts
}

const { card, readCta, reveal = false } = Astro.props;
---

<article class="rc-arow" data-reveal={reveal ? '' : undefined}>
  <div class="rc-arow__head">
    <div class="rc-meta">
      <span>{card.dateDisplay}</span>
      <span class="rc-meta__dot"></span>
      <span class="rc-arow__kind">{card.kindLabel}</span>
    </div>
  </div>
  <h3 class="rc-arow__title"><a href={card.href}>{card.title}</a></h3>
  <p class="rc-arow__dek">{card.dek}</p>
  <div class="rc-arow__tags">
    {card.tags.map((t) => <span class="rc-tag">{t}</span>)}
  </div>
  <span class="rc-arow__cta" aria-hidden="true">{readCta} →</span>
</article>

<style>
  /* Ported 1:1 from ArticleListItem's .rc-arow* / .rc-meta* / .rc-tag so the radar
     feed and the article list share the exact row anatomy + hover idiom. The only
     additions: .rc-arow__kind (the mono kind label in the meta row) and a plain
     (non-link) .rc-tag. Tokens only. */
  .rc-arow {
    text-align: left;
    border-bottom: 1px solid var(--hairline);
    border-left: 2px solid transparent;
    padding: 26px 0;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-auto-rows: min-content;
    gap: 8px 24px;
    transition:
      padding var(--dur-hover) var(--ease-soft),
      background var(--dur-hover) var(--ease-soft),
      border-left-color var(--dur-hover) var(--ease-soft);
  }
  .rc-arow:hover {
    padding-left: 16px;
    padding-right: 16px;
    border-left-color: var(--accent);
    background: var(--accent-soft);
  }
  .rc-arow__head {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .rc-meta {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-subtle);
  }
  .rc-meta__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--fg-subtle);
    display: inline-block;
  }
  /* the kind label carries the accent ink (it is the radar row's signal) */
  .rc-arow__kind {
    color: var(--accent-text);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 11px;
  }
  .rc-arow__title {
    grid-column: 1;
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-variation-settings: var(--fraunces-sub);
    font-size: var(--text-h3);
    line-height: 1.25;
    color: var(--fg);
    transition: color var(--dur-hover) var(--ease-soft);
  }
  .rc-arow__title a {
    color: inherit;
  }
  .rc-arow:hover .rc-arow__title {
    color: var(--accent);
  }
  .rc-arow__dek {
    grid-column: 1;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 64ch;
  }
  .rc-arow__tags {
    grid-column: 1;
    display: flex;
    gap: 8px;
    margin-top: 6px;
    flex-wrap: wrap;
  }
  .rc-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    padding: 3px 11px;
    border-radius: var(--radius-pill);
    background: var(--fill-subtle);
    color: var(--fg-muted);
    border: 1px solid var(--border-subtle);
  }
  .rc-arow__cta {
    grid-column: 2;
    grid-row: 2 / 4;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-text);
    white-space: nowrap;
  }
</style>
