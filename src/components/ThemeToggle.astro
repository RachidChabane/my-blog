---
/**
 * Theme toggle — non-figurative Lucide sun/moon icon button (INV-9: SVG, no emoji).
 * Both icons render; CSS shows the right one per [data-theme]. The island script
 * binds toggleTheme() to every .theme-toggle (future-proof for the task-6 footer).
 */
---

<button type="button" class="theme-toggle" aria-label="Toggle light and dark theme">
  <svg
    class="theme-toggle__icon theme-toggle__icon--moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6.4 6.4 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <line x1="12" y1="2" x2="12" y2="4"></line>
    <line x1="12" y1="20" x2="12" y2="22"></line>
    <line x1="4.9" y1="4.9" x2="6.3" y2="6.3"></line>
    <line x1="17.7" y1="17.7" x2="19.1" y2="19.1"></line>
    <line x1="2" y1="12" x2="4" y2="12"></line>
    <line x1="20" y1="12" x2="22" y2="12"></line>
    <line x1="4.9" y1="19.1" x2="6.3" y2="17.7"></line>
    <line x1="17.7" y1="6.3" x2="19.1" y2="4.9"></line>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius);
    border: 1px solid transparent;
    background: transparent;
    color: var(--fg-muted);
    transition: all var(--dur-hover) var(--ease-soft);
  }
  .theme-toggle:hover {
    background: var(--fill-subtle);
    color: var(--fg);
  }
  .theme-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--accent-ring);
    color: var(--fg);
  }
  /* Show moon in light (click → dark); show sun in dark (click → light). */
  .theme-toggle__icon--sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle__icon--moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle__icon--sun {
    display: block;
  }
</style>

<script>
  import { toggleTheme } from '@/lib/theme';

  for (const btn of document.querySelectorAll<HTMLElement>('.theme-toggle')) {
    btn.addEventListener('click', () => {
      toggleTheme();
    });
  }
</script>
