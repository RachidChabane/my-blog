---
/**
 * Masthead — sticky top bar. Typographic wordmark→home (rendered as an anchor,
 * never a page heading, so the one-heading-per-page contract holds), primary nav, inert search
 * affordance, language switcher, theme toggle. Ports the design's .rc-nav
 * (tokens only). Primary nav links are LIVE anchors to canonical routes
 * (/[lang]/blog|work|about/) that later tasks build; static build does not
 * validate hrefs and there is no link-check gate, so they only dangle between
 * build steps (never on a deployed site — INV-3 is a launch-time property).
 */
import { localePath } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import { chrome, NAV_ITEMS } from '@/i18n/ui';
import ThemeToggle from '@/components/ThemeToggle.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import SearchTrigger from '@/components/SearchTrigger.astro';

interface Props {
  lang: Locale;
  slugMap?: Partial<Record<Locale, string>>;
  switchSection?: string; // forwarded to the language switcher (default 'blog')
}

const { lang, slugMap, switchSection } = Astro.props;
const c = chrome(lang);
---

<header class="masthead">
  <a class="masthead__wordmark" href={localePath(lang)} aria-label={c.homeAria}>
    <span class="masthead__word"
      >rachid chabane<span class="masthead__dot">.</span></span
    >
  </a>
  <nav class="masthead__nav" id="masthead-nav" aria-label={c.navAria}>
    {NAV_ITEMS.map((it) => <a href={localePath(lang, it.path)}>{c[it.key]}</a>)}
  </nav>
  <div class="masthead__right">
    <SearchTrigger lang={lang} />
    <LanguageSwitcher lang={lang} slugMap={slugMap} section={switchSection} />
    <ThemeToggle label={c.themeToggleAria} />
    <button
      type="button"
      class="masthead__toggle"
      aria-label={c.menuToggleAria}
      aria-controls="masthead-nav"
      aria-expanded="false"
    >
      <svg
        class="masthead__burger"
        viewBox="0 0 20 20"
        width="20"
        height="20"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="17" y2="6"></line>
        <line x1="3" y1="10" x2="17" y2="10"></line>
        <line x1="3" y1="14" x2="17" y2="14"></line>
      </svg>
    </button>
  </div>
</header>

<script>
  // Mobile nav disclosure. Below 720px the primary nav collapses behind a
  // hamburger; this wires the toggle, then closes on link click, Escape, an
  // outside click, or a resize back to the wide layout. Desktop is untouched
  // (the button is display:none above the breakpoint). Const arrow fns + a null
  // guard keep the bundled island narrowing intact.
  const masthead = document.querySelector<HTMLElement>('.masthead');
  const toggle =
    masthead?.querySelector<HTMLButtonElement>('.masthead__toggle');
  const nav = masthead?.querySelector<HTMLElement>('.masthead__nav');
  if (masthead && toggle && nav) {
    const isOpen = (): boolean => masthead.dataset.menu === 'open';
    const setOpen = (open: boolean): void => {
      masthead.dataset.menu = open ? 'open' : 'closed';
      toggle.setAttribute('aria-expanded', String(open));
    };
    setOpen(false);
    toggle.addEventListener('click', () => setOpen(!isOpen()));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !masthead.contains(e.target as Node)) setOpen(false);
    });
    const wide = window.matchMedia('(min-width: 721px)');
    wide.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  /* Ported from design .rc-nav / .rc-wordmark / .rc-nav__links / .rc-nav__right.
     Tokens only. The in-wordmark avatar mark is deliberately omitted (D-007:
     typographic wordmark; the avatar mark is task-20 territory). */
  .masthead {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 40px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--hairline);
  }
  .masthead__wordmark {
    display: inline-flex;
    align-items: center;
  }
  .masthead__word {
    font-family: var(--font-display);
    font-variation-settings:
      'opsz' 36,
      'wght' 510;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .masthead__dot {
    color: var(--accent);
  }
  .masthead__nav {
    display: flex;
    gap: 22px;
    margin-left: 14px;
  }
  .masthead__nav a {
    position: relative;
    padding: 4px 0;
    font-size: 14px;
    color: var(--fg-muted);
    transition: color var(--dur-hover) var(--ease-soft);
  }
  .masthead__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1.5px;
    background: var(--accent);
    transition: width var(--dur-hover) var(--ease-soft);
  }
  .masthead__nav a:hover {
    color: var(--fg);
  }
  .masthead__nav a:hover::after {
    width: 100%;
  }
  .masthead__right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* Hamburger toggle: hidden on the wide layout, shown only below the breakpoint. */
  .masthead__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    cursor: pointer;
    transition:
      color var(--dur-hover) var(--ease-soft),
      border-color var(--dur-hover) var(--ease-soft);
  }
  .masthead__toggle:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
  }
  .masthead__burger line {
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* Below 720px the inline nav row collapses into a dropdown behind the toggle.
     Closed, the nav is display:none (no hit-testing, so it never occludes the
     page); open, it anchors under the sticky masthead as a tokenized card. */
  @media (max-width: 720px) {
    .masthead {
      padding-left: 22px;
      padding-right: 22px;
    }
    .masthead__toggle {
      display: inline-flex;
    }
    .masthead__nav {
      display: none;
      position: absolute;
      top: 100%;
      right: 22px;
      flex-direction: column;
      gap: var(--sp-1);
      min-width: 168px;
      margin-left: 0;
      padding: var(--sp-3);
      background: var(--bg);
      border: 1px solid var(--hairline);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
    }
    .masthead[data-menu='open'] .masthead__nav {
      display: flex;
    }
    .masthead__nav a {
      padding: var(--sp-2) var(--sp-1);
      font-size: 15px;
    }
    /* The animated underline reads as a stray bar in the stacked menu. */
    .masthead__nav a::after {
      display: none;
    }
  }
</style>
