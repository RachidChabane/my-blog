---
/* Prose — styled wrapper for rendered article markdown (the <Content/> from
   render()). Astro scoped styles get a scope hash that the <Content/>-injected
   HTML never carries, so every element rule reaches the body via
   `.rc-article__body :global(...)` descendant selectors (plan finding #5).

   Assumes the body leads with a paragraph (drop cap on the direct-child
   p:first-child, which excludes the blockquote's inner <p>); body headings start
   at <h2> (the article title is the page's only <h1>). Ports site.css
   .rc-article__body / .rc-drop / .rc-pull / .rc-code + screens.css body-link
   rules. Tokens only — no hard-coded colors/fonts/spacing. */
---

<div class="rc-article__body"><slot /></div>

<style>
  .rc-article__body {
    margin-top: 36px;
  }

  /* paragraphs ----------------------------------------------------------- */
  .rc-article__body :global(p) {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--fg);
    margin: 0 0 24px;
  }

  /* drop cap on the lead paragraph only. Direct-child `>` so the blockquote's
     inner <p> is never capped (plan §3.5). */
  .rc-article__body > :global(p:first-child)::first-letter {
    font-family: var(--font-display);
    font-variation-settings: var(--fraunces-display);
    font-size: 64px;
    float: left;
    line-height: 0.78;
    padding: 8px 12px 0 0;
    color: var(--accent);
  }

  /* pull-quote (markdown `> …` → <blockquote><p>…</p></blockquote>) --------- */
  .rc-article__body :global(blockquote) {
    margin: 36px 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid var(--accent);
  }
  .rc-article__body :global(blockquote p) {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings:
      'opsz' 36,
      'wght' 440;
    font-size: 23px;
    line-height: 1.4;
    color: var(--fg-muted);
  }

  /* code block (syntaxHighlight:false → plain token-styled <pre><code>) ----- */
  .rc-article__body :global(pre) {
    background: var(--bg-sunken);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 18px 20px;
    margin: 32px 0;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.65;
    overflow-x: auto;
  }
  .rc-article__body :global(pre code) {
    font: inherit;
    color: inherit;
    padding: 0;
    background: none;
  }

  /* inline code (any <code> whose parent is not <pre>) --------------------- */
  .rc-article__body :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: var(--fill-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--fg);
  }

  /* body links (markdown inline links) ------------------------------------ */
  .rc-article__body :global(a) {
    color: var(--accent);
    border-bottom: 1px solid var(--accent-ring);
    transition: border-color var(--dur-hover) var(--ease-soft);
  }
  .rc-article__body :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  /* body headings start at <h2> (pipeline articles; seeds have none) ------- */
  .rc-article__body :global(h2),
  .rc-article__body :global(h3) {
    font-family: var(--font-display);
    font-variation-settings: var(--fraunces-sub);
    color: var(--fg);
    letter-spacing: -0.01em;
  }
  .rc-article__body :global(h2) {
    margin: 40px 0 14px;
    font-size: var(--text-h3);
    line-height: 1.25;
  }
  .rc-article__body :global(h3) {
    margin: 32px 0 12px;
    font-size: 19px;
    line-height: 1.3;
  }

  /* lists ----------------------------------------------------------------- */
  .rc-article__body :global(ul),
  .rc-article__body :global(ol) {
    margin: 0 0 24px;
    padding-left: 24px;
  }
  .rc-article__body :global(li) {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--fg);
    margin: 0 0 8px;
  }
</style>
