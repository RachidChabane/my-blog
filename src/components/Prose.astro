---
/* Prose — DOSSIER reading surface for rendered article markdown (the <Content/>
   from render()). Astro scoped styles get a scope hash that the <Content/>-injected
   HTML never carries, so every element rule reaches the body via
   `.rc-article__body :global(...)` descendant selectors (plan finding #5).

   The markdown carries PROSE only; all page structure (contents rail, header,
   glossary panel, source cards, key-facts) lives in the route. Here: section
   headings auto-number (CSS counter) and carry scroll-margin for the sticky rail;
   `> [!TYPE]` blockquotes arrive already rewritten to soft <aside class="cl cl--type">
   cards by remark-callouts (a confirmed/inferred pair is wrapped in .cl-pair and
   laid out side-by-side); GFM tables render as clean bordered panels; code sits on
   a quiet surface. Color is restrained and semantic. Tokens only. */
---

<div class="rc-article__body"><slot /></div>

<style>
  .rc-article__body {
    counter-reset: rc-sec;
  }

  /* paragraphs ----------------------------------------------------------- */
  .rc-article__body :global(p) {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--fg);
    margin: 0 0 20px;
  }
  .rc-article__body > :global(p:first-of-type) {
    font-size: 1.15rem;
    line-height: 1.6;
  }

  /* numbered section headings — accent numeral + serif, like the reference --- */
  .rc-article__body :global(h2) {
    counter-increment: rc-sec;
    scroll-margin-top: 92px;
    margin: 46px 0 16px;
    font-family: var(--font-display);
    font-variation-settings:
      'opsz' 48,
      'wght' 540;
    font-size: var(--text-h2);
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--fg);
  }
  .rc-article__body :global(h2)::before {
    content: counter(rc-sec) '.';
    margin-right: 0.5ch;
    font-variation-settings:
      'opsz' 48,
      'wght' 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .rc-article__body :global(h3) {
    scroll-margin-top: 92px;
    margin: 32px 0 12px;
    font-family: var(--font-display);
    font-variation-settings:
      'opsz' 32,
      'wght' 560;
    font-size: var(--text-h3);
    line-height: 1.3;
    color: var(--fg);
  }

  /* pull-quote (plain `> …`; callouts are <aside>, styled below) ------------ */
  .rc-article__body :global(blockquote) {
    margin: 28px 0;
    padding: 4px 0 4px 22px;
    border-left: 3px solid var(--accent);
  }
  .rc-article__body :global(blockquote p) {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings:
      'opsz' 36,
      'wght' 420,
      'SOFT' 40;
    font-size: 1.4rem;
    line-height: 1.4;
    color: var(--fg-muted);
  }

  /* callout cards (remark-callouts: `> [!TYPE]` → <aside class="cl cl--type">) -
     Soft rounded card, a tinted background + matching border, a colored icon +
     label. Body text stays --fg ink for legibility. */
  .rc-article__body :global(.cl) {
    --cl: var(--accent);
    --cl-soft: var(--accent-soft);
    margin: 26px 0;
    padding: 16px 18px 4px;
    border: 1px solid color-mix(in srgb, var(--cl) 38%, transparent);
    border-radius: var(--radius);
    background: var(--cl-soft);
  }
  .rc-article__body :global(.cl--note) {
    --cl: var(--cl-note);
    --cl-soft: var(--cl-note-soft);
  }
  .rc-article__body :global(.cl--tip),
  .rc-article__body :global(.cl--confirmed) {
    --cl: var(--cl-tip);
    --cl-soft: var(--cl-tip-soft);
  }
  .rc-article__body :global(.cl--important) {
    --cl: var(--cl-important);
    --cl-soft: var(--cl-important-soft);
  }
  .rc-article__body :global(.cl--warning) {
    --cl: var(--cl-warn);
    --cl-soft: var(--cl-warn-soft);
  }
  .rc-article__body :global(.cl--caution),
  .rc-article__body :global(.cl--inferred) {
    --cl: var(--cl-caution);
    --cl-soft: var(--cl-caution-soft);
  }
  .rc-article__body :global(.cl__label) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cl);
  }
  .rc-article__body :global(.cl__label)::before {
    font-size: 0.95em;
    font-weight: 700;
  }
  .rc-article__body :global(.cl--note .cl__label)::before {
    content: 'ⓘ';
  }
  .rc-article__body :global(.cl--tip .cl__label)::before,
  .rc-article__body :global(.cl--confirmed .cl__label)::before {
    content: '✓';
  }
  .rc-article__body :global(.cl--important .cl__label)::before {
    content: '▲';
  }
  .rc-article__body :global(.cl--warning .cl__label)::before {
    content: '△';
  }
  .rc-article__body :global(.cl--caution .cl__label)::before {
    content: '✕';
  }
  .rc-article__body :global(.cl--inferred .cl__label)::before {
    content: '≈';
  }
  .rc-article__body :global(.cl p) {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 12px;
  }
  /* the epistemic pair → side-by-side cards (remark-callouts wraps them). */
  .rc-article__body :global(.cl-pair) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 26px 0;
  }
  .rc-article__body :global(.cl-pair .cl) {
    margin: 0;
  }
  @media (max-width: 620px) {
    .rc-article__body :global(.cl-pair) {
      grid-template-columns: 1fr;
    }
  }

  /* tables — a clean bordered panel; tinted header, hairline rows ------------ */
  .rc-article__body :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 26px 0;
    font-size: 0.95rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .rc-article__body :global(thead th) {
    text-align: left;
    padding: 11px 16px;
    background: var(--band);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
    border-bottom: 1px solid var(--border);
  }
  .rc-article__body :global(tbody td) {
    padding: 11px 16px;
    color: var(--fg);
    line-height: 1.5;
    vertical-align: top;
    border-bottom: 1px solid var(--hairline);
  }
  .rc-article__body :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .rc-article__body :global(td[align='right']),
  .rc-article__body :global(th[align='right']) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .rc-article__body :global(td[align='center']),
  .rc-article__body :global(th[align='center']) {
    text-align: center;
  }

  /* code — a quiet rounded surface block ----------------------------------- */
  .rc-article__body :global(pre) {
    background: var(--bg-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 16px 18px;
    margin: 24px 0;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.65;
    overflow-x: auto;
  }
  .rc-article__body :global(pre code) {
    font: inherit;
    color: inherit;
    padding: 0;
    background: none;
    border: 0;
  }
  .rc-article__body :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 1.5px 6px;
    border-radius: var(--radius-sm);
    background: var(--fill-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--fg);
  }

  /* links + emphasis ------------------------------------------------------- */
  .rc-article__body :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-color: var(--accent-ring);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 2.5px;
    transition: text-decoration-color var(--dur-hover) var(--ease-soft);
  }
  .rc-article__body :global(a:hover) {
    text-decoration-color: var(--accent);
  }
  .rc-article__body :global(strong) {
    font-weight: 650;
    color: var(--fg);
  }

  /* lists ------------------------------------------------------------------ */
  .rc-article__body :global(ul),
  .rc-article__body :global(ol) {
    margin: 0 0 22px;
    padding-left: 24px;
  }
  .rc-article__body :global(li) {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body);
    color: var(--fg);
    margin: 0 0 8px;
  }
  .rc-article__body :global(li)::marker {
    color: var(--accent);
  }

  .rc-article__body :global(hr) {
    margin: 38px 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  /* quiz reveal (Lesson articles end with <details><summary>Q</summary>A) --- */
  .rc-article__body :global(details) {
    margin: 0 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 14px 18px;
    font-size: var(--text-body-lg);
    line-height: var(--leading-body);
    color: var(--fg);
  }
  .rc-article__body :global(summary) {
    cursor: pointer;
    font-weight: 600;
    color: var(--fg);
    transition: color var(--dur-hover) var(--ease-soft);
  }
  .rc-article__body :global(summary:hover),
  .rc-article__body :global(details[open] summary) {
    color: var(--accent-text);
  }
  .rc-article__body :global(details[open] summary) {
    margin-bottom: 8px;
  }
</style>
