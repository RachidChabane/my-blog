---
/**
 * Avatar panel skeleton (S10). Server-renders the panel structure + copy-bearing
 * <template>s; the root island clones them and toggles regions — COPY NEVER LIVES
 * IN JS. The mark is the non-figurative 4x4 lattice ("maillage"): an abstract
 * mesh, no human likeness, no figure, no living being (D-007). Citations render
 * BEFORE prose (the grounded template orders .rc-cite then .rc-ans__prose). All
 * icons are inline stroke="currentColor" SVG glyphs (INV-9; no emoji). Styles
 * live in src/styles/avatar.css, imported by the root component.
 */
import type { AvatarStrings } from '@/i18n/ui';
import type { Locale } from '@/i18n/index';

interface Props {
  strings: AvatarStrings;
  lang: Locale;
}

// `lang` is accepted (the root passes it for parity with future per-locale
// branches) but the panel needs only the already-localized `strings`.
const { strings } = Astro.props;
---

<section
  id="avatar-panel"
  class="rc-ava"
  role="dialog"
  aria-modal="false"
  aria-label={strings.title}
  data-avatar-panel
  data-state="idle"
  hidden
>
  <div class="rc-ava__head">
    <span class="rc-mark is-idle" data-avatar-headmark aria-hidden="true">
      {Array.from({ length: 16 }).map(() => <b class="rc-mark__node" />)}
    </span>
    <span class="rc-ava__titles">
      <span class="rc-ava__title">{strings.title}</span>
      <span class="rc-ava__sub">{strings.subtitle}</span>
    </span>
    <button
      class="rc-icon-btn"
      type="button"
      data-avatar-close
      aria-label={strings.close}
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div
    class="rc-ava__body"
    data-avatar-body
    role="log"
    aria-live="polite"
    aria-relevant="additions"
    aria-label={strings.title}
  >
  </div>

  <div class="rc-ava__input" data-avatar-form>
    <input
      data-avatar-input
      type="text"
      autocomplete="off"
      aria-label={strings.inputLabel}
      placeholder={strings.placeholder}
    />
    <button
      class="rc-send"
      type="button"
      data-avatar-send
      aria-label={strings.send}
    >
      <svg
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="12" y1="19" x2="12" y2="5"></line>
        <polyline points="5 12 12 5 19 12"></polyline>
      </svg>
    </button>
  </div>

  <!-- copy-bearing templates cloned at runtime (COPY NEVER LIVES IN JS) -->
  <template data-tpl-user>
    <div class="rc-bub rc-bub--me" data-slot="text"></div>
  </template>

  <template data-tpl-thinking>
    <div class="rc-think-row" data-avatar-thinking>
      <span class="rc-mark is-thinking" aria-hidden="true">
        {Array.from({ length: 16 }).map(() => <b class="rc-mark__node" />)}
      </span>
      <span class="rc-think-lbl">{strings.thinking}</span>
    </div>
  </template>

  <template data-tpl-grounded>
    <div class="rc-ans">
      <div class="rc-cite" data-slot="cites"></div>
      <div class="rc-ans__prose" data-slot="prose"></div>
    </div>
  </template>

  <!-- Cite-row INNER content only. The <a> wrapper is built in the island (an
       <a> is a formatting element; left inside a <template> the HTML parser
       reconstructs it OUTSIDE the template, leaking a stray empty link into the
       page. A <span> root is inert and safe to clone.) -->
  <template data-tpl-cite>
    <span class="rc-cite__inner">
      <span class="rc-cite__lbl">
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M10 11H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v7c0 2-1 3-3 4"
          ></path>
          <path
            d="M19 11h-4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v7c0 2-1 3-3 4"
          ></path>
        </svg>
        {strings.sourceLbl}
      </span>
      <span class="rc-cite__title" data-slot="title"></span>
    </span>
  </template>

  <template data-tpl-refuse>
    <div class="rc-ans rc-ans--refuse">
      <span class="rc-refuse-tag">{strings.refuseTag}</span>
      <div class="rc-ans__prose" data-slot="prose"></div>
    </div>
  </template>

  <!-- Artifact: layered diagram. The island clones this, fills the dynamic title +
       layers (textContent / createElement — never a markup sink), and labels the
       whole figure as one role="img" unit so the live region announces it once
       (not every node). The provenance line keeps the synthesized nature explicit
       (a diagram carries no citations). -->
  <template data-tpl-diagram>
    <figure class="rc-art rc-art--diagram" role="img">
      <figcaption class="rc-art__title" data-slot="title" hidden></figcaption>
      <div class="rc-adia" data-slot="layers" aria-hidden="true"></div>
      <span class="rc-art__prov">{strings.diagramProv}</span>
    </figure>
  </template>

  <!-- Artifact: plain (NOT highlighted) code card with a copy button. The island
       fills the <code> via textContent and wires the copy button; the button's two
       labels live here (COPY NEVER LIVES IN JS). -->
  <template data-tpl-code>
    <figure class="rc-art rc-art--code">
      <div class="rc-art__bar">
        <span class="rc-art__lang" data-slot="lang"></span>
        <button
          class="rc-art__copy"
          type="button"
          data-slot="copy"
          data-label-copied={strings.copied}>{strings.copy}</button
        >
      </div>
      <pre class="rc-art__pre"><code data-slot="code" /></pre>
    </figure>
  </template>

  <p class="visually-hidden" data-avatar-error>{strings.error}</p>
</section>
