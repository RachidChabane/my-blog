---
/**
 * S10 avatar overlay. Always-present, non-figurative abstract lattice ("maillage")
 * — no human likeness, no figure, no living being, no mark of a creature (D-007).
 * Idle launcher + active chat panel (idle / thinking / answering / refusal).
 * Citations precede prose. Wired to POST /api/avatar/query (SSE). Vanilla island —
 * no framework. The island NEVER writes untrusted text as markup (it assigns
 * textContent / appends text nodes only, no raw-markup sink), and only links
 * citation URLs that pass an allow-list.
 */
import '@/styles/avatar.css';
import Panel from '@/components/avatar/Panel.astro';
import { chrome, avatarStrings } from '@/i18n/ui';
import type { Locale } from '@/i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const c = chrome(lang);
const s = avatarStrings(lang);
---

<div class="rc-dock" data-avatar-root>
  <Panel strings={s} lang={lang} />
  <button
    class="rc-fab"
    data-avatar-slot
    aria-label={c.avatarAria}
    aria-haspopup="dialog"
    aria-controls="avatar-panel"
    aria-expanded="false"
  >
    <span class="rc-mark is-idle" data-avatar-launchmark aria-hidden="true">
      {Array.from({ length: 16 }).map(() => <b class="rc-mark__node" />)}
    </span>
  </button>
</div>

<script>
  import { SSE_EVENT, parseSSE } from '@/lib/avatar/protocol';
  import type {
    Citation,
    SourcesEventData,
    TokenEventData,
    IdkEventData,
    Artifact,
    DiagramArtifact,
    CodeArtifact,
  } from '@/lib/avatar/protocol';
  import { takeFrames } from '@/lib/sse-frames';

  // Capture every node the behavior uses, ONCE. The single guard below lists all
  // of them so the const arrow functions that follow keep TypeScript's non-null
  // narrowing (a hoisted `function` decl, or a node used but absent from the
  // guard, re-introduces astro-check's 'possibly null').
  const root = document.querySelector<HTMLElement>('[data-avatar-root]');
  const panel = root?.querySelector<HTMLElement>('[data-avatar-panel]');
  const launcher = root?.querySelector<HTMLButtonElement>('[data-avatar-slot]');
  const body = root?.querySelector<HTMLElement>('[data-avatar-body]');
  const form = root?.querySelector<HTMLElement>('[data-avatar-form]');
  const input = root?.querySelector<HTMLInputElement>('[data-avatar-input]');
  const sendBtn = root?.querySelector<HTMLButtonElement>('[data-avatar-send]');
  const closeBtn = root?.querySelector<HTMLButtonElement>(
    '[data-avatar-close]'
  );
  const launchMark = root?.querySelector<HTMLElement>(
    '[data-avatar-launchmark]'
  );
  const headMark = root?.querySelector<HTMLElement>('[data-avatar-headmark]');
  const errorLine = root?.querySelector<HTMLElement>('[data-avatar-error]');
  const tplUser = root?.querySelector<HTMLTemplateElement>('[data-tpl-user]');
  const tplThink = root?.querySelector<HTMLTemplateElement>(
    '[data-tpl-thinking]'
  );
  const tplGround = root?.querySelector<HTMLTemplateElement>(
    '[data-tpl-grounded]'
  );
  const tplCite = root?.querySelector<HTMLTemplateElement>('[data-tpl-cite]');
  const tplRefuse =
    root?.querySelector<HTMLTemplateElement>('[data-tpl-refuse]');
  const tplDiagram =
    root?.querySelector<HTMLTemplateElement>('[data-tpl-diagram]');
  const tplCode = root?.querySelector<HTMLTemplateElement>('[data-tpl-code]');

  if (
    root &&
    panel &&
    launcher &&
    body &&
    form &&
    input &&
    sendBtn &&
    closeBtn &&
    launchMark &&
    headMark &&
    errorLine &&
    tplUser &&
    tplThink &&
    tplGround &&
    tplCite &&
    tplRefuse &&
    tplDiagram &&
    tplCode
  ) {
    let busy = false;
    let ansEl: HTMLElement | null = null; // current grounded answer container (.rc-ans)
    let proseEl: HTMLElement | null = null; // current open prose run, or null after an artifact
    // Per-article scope: the slug an "ask about this article" trigger set, or null for the
    // corpus-wide launcher. Sent as scopeSlug so the answer (and the honest refusal) is
    // restricted to that article; cleared when the panel closes or the FAB opens fresh.
    let askScope: string | null = null;

    const cloneTpl = (tpl: HTMLTemplateElement): HTMLElement => {
      const node = tpl.content.firstElementChild;
      return (
        node ? node.cloneNode(true) : document.createElement('div')
      ) as HTMLElement;
    };

    const scrollToEnd = () => {
      body.scrollTop = body.scrollHeight;
    };

    const setMarks = (thinking: boolean) => {
      for (const m of [launchMark, headMark]) {
        m.classList.toggle('is-thinking', thinking);
        m.classList.toggle('is-idle', !thinking);
      }
    };

    const isOpen = () => !panel.hidden;

    const open = () => {
      panel.hidden = false;
      panel.dataset.state = 'idle';
      launcher.setAttribute('aria-expanded', 'true');
      input.focus();
    };

    const close = () => {
      panel.hidden = true;
      launcher.setAttribute('aria-expanded', 'false');
      launcher.focus();
      askScope = null; // a fresh open is corpus-wide unless a trigger re-scopes it
    };

    // Allow http(s) absolute, or a single-leading-slash same-origin relative path.
    // Protocol-relative `//host` is rejected (the browser resolves it off-origin).
    const isSafeHref = (u: string): boolean =>
      /^https?:/i.test(u) || /^\/(?!\/)/.test(u);

    const removeThinking = () => {
      const row = body.querySelector('[data-avatar-thinking]');
      if (row) row.remove();
    };

    // Idempotent: runs once on the `done` dispatch AND once after the read loop.
    const finish = () => {
      busy = false;
      input.disabled = false;
      sendBtn.disabled = false;
      removeThinking();
      setMarks(false);
      panel.dataset.state = 'idle';
      if (isOpen()) input.focus();
    };

    const showError = () => {
      const row = document.createElement('div');
      row.className = 'rc-ans';
      const prose = document.createElement('div');
      prose.className = 'rc-ans__prose';
      prose.textContent = errorLine.textContent ?? '';
      row.append(prose);
      body.append(row);
      scrollToEnd();
      finish();
    };

    const appendUser = (text: string) => {
      const node = cloneTpl(tplUser);
      // The user-bubble template's ROOT element carries data-slot="text" (it has no
      // child slot), and querySelector only searches descendants — so match self OR
      // a descendant, else the bubble renders empty.
      const slot = node.matches('[data-slot="text"]')
        ? node
        : node.querySelector<HTMLElement>('[data-slot="text"]');
      if (slot) slot.textContent = text;
      body.append(node);
    };

    const renderSources = (citations: Citation[]) => {
      removeThinking();
      const ans = cloneTpl(tplGround);
      const cites = ans.querySelector<HTMLElement>('[data-slot="cites"]');
      const prose = ans.querySelector<HTMLElement>('[data-slot="prose"]');
      for (const cit of citations) {
        // Build the <a> in JS (an <a> cannot live in the <template> — it would
        // leak out of it during HTML parsing). The inner content (icon + label +
        // title) is cloned from the inert <span> template, keeping copy out of JS.
        const row = document.createElement('a');
        row.className = 'rc-cite__row';
        const inner = cloneTpl(tplCite);
        const title = inner.querySelector<HTMLElement>('[data-slot="title"]');
        if (title) title.textContent = cit.title;
        if (isSafeHref(cit.sourceUrl)) row.href = cit.sourceUrl; // allow-list (D5)
        row.append(inner);
        if (cites) cites.append(row);
      }
      body.append(ans);
      ansEl = ans; // artifacts + later prose runs append here, after the citations
      proseEl = prose; // citations are in the DOM BEFORE any prose text
      scrollToEnd();
    };

    // Start a fresh prose run inside the current answer (after an artifact closed the
    // previous one, or for a token that arrives with no open run).
    const ensureProse = (): HTMLElement | null => {
      if (proseEl) return proseEl;
      if (!ansEl) return null;
      const p = document.createElement('div');
      p.className = 'rc-ans__prose';
      ansEl.append(p);
      proseEl = p;
      return p;
    };

    const appendToken = (text: string) => {
      const prose = ensureProse();
      if (!prose) return; // defensive: a stray token before any sources frame
      prose.append(document.createTextNode(text)); // text node — never a markup sink
      panel.dataset.state = 'answering';
      scrollToEnd();
    };

    // Build a layered diagram with safe DOM only (textContent / createElement). The
    // whole figure is one role="img" labelled unit, so the live region announces it
    // once; the inner lattice is aria-hidden. Connectors are CSS (no extra nodes).
    const renderDiagram = (d: DiagramArtifact): HTMLElement => {
      const fig = cloneTpl(tplDiagram);
      const titleEl = fig.querySelector<HTMLElement>('[data-slot="title"]');
      if (titleEl) {
        if (d.title) {
          titleEl.textContent = d.title;
          titleEl.hidden = false;
        }
      }
      const layersEl = fig.querySelector<HTMLElement>('[data-slot="layers"]');
      for (const layer of d.layers) {
        const row = document.createElement('div');
        row.className = 'rc-adia__layer';
        const lbl = document.createElement('span');
        lbl.className = 'rc-adia__label';
        lbl.textContent = layer.label;
        const nodes = document.createElement('div');
        nodes.className = 'rc-adia__nodes';
        for (const n of layer.nodes) {
          const node = document.createElement('span');
          node.className = 'rc-adia__node';
          node.textContent = n;
          nodes.append(node);
        }
        row.append(lbl, nodes);
        layersEl?.append(row);
      }
      const prov = fig.querySelector<HTMLElement>('.rc-art__prov');
      const label = [d.title, d.caption, prov?.textContent ?? '']
        .filter(Boolean)
        .join('. ');
      fig.setAttribute('aria-label', label);
      return fig;
    };

    // Build a plain code card. The code is set via textContent (never a markup sink);
    // the copy button copies the literal source and swaps to its confirmation label.
    const renderCode = (c: CodeArtifact): HTMLElement => {
      const fig = cloneTpl(tplCode);
      const langEl = fig.querySelector<HTMLElement>('[data-slot="lang"]');
      if (langEl) {
        if (c.lang) langEl.textContent = c.lang;
        else langEl.hidden = true;
      }
      const codeEl = fig.querySelector<HTMLElement>('[data-slot="code"]');
      if (codeEl) codeEl.textContent = c.code;
      const copyBtn =
        fig.querySelector<HTMLButtonElement>('[data-slot="copy"]');
      if (copyBtn) {
        const idle = copyBtn.textContent ?? '';
        const done = copyBtn.dataset.labelCopied ?? idle;
        copyBtn.addEventListener('click', () => {
          void navigator.clipboard
            ?.writeText(c.code)
            .then(() => {
              copyBtn.textContent = done;
              window.setTimeout(() => {
                copyBtn.textContent = idle;
              }, 1500);
            })
            .catch(() => {
              /* clipboard denied (focus/permission): leave the label unchanged */
            });
        });
      }
      return fig;
    };

    const renderArtifact = (artifact: Artifact) => {
      if (!ansEl) return; // sources always precede artifacts; defensive otherwise
      proseEl = null; // an artifact closes the current prose run
      const el =
        artifact.kind === 'diagram'
          ? renderDiagram(artifact)
          : renderCode(artifact);
      ansEl.append(el);
      panel.dataset.state = 'answering';
      scrollToEnd();
    };

    const renderIdk = (message: string) => {
      removeThinking();
      const ans = cloneTpl(tplRefuse);
      const prose = ans.querySelector<HTMLElement>('[data-slot="prose"]');
      if (prose) prose.textContent = message; // server-provided, localized
      body.append(ans);
      panel.dataset.state = 'idk';
      scrollToEnd();
    };

    const dispatch = (event: string, data: unknown) => {
      if (event === SSE_EVENT.sources) {
        renderSources((data as SourcesEventData).citations ?? []);
      } else if (event === SSE_EVENT.token) {
        appendToken((data as TokenEventData).text ?? '');
      } else if (event === SSE_EVENT.artifact) {
        renderArtifact(data as Artifact);
      } else if (event === SSE_EVENT.idk) {
        renderIdk((data as IdkEventData).message ?? '');
        // data.suggestions intentionally NOT rendered (the refusal carries no
        // .rc-cite — see plan C4).
      } else if (event === SSE_EVENT.error) {
        showError();
      } else if (event === SSE_EVENT.done) {
        finish();
      }
    };

    const ask = async (query: string) => {
      ansEl = null;
      proseEl = null;
      try {
        const res = await fetch('/api/avatar/query', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query,
            lang: document.documentElement.lang,
            ...(askScope ? { scopeSlug: askScope } : {}),
          }),
        });
        if (!res.ok || !res.body) {
          showError();
          return;
        }
        const reader = res.body.getReader();
        const dec = new TextDecoder();
        let buf = '';
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          buf += dec.decode(value, { stream: true });
          const { frames, rest } = takeFrames(buf);
          buf = rest; // keep the trailing incomplete remainder
          for (const frame of frames)
            for (const { event, data } of parseSSE(frame))
              dispatch(event, data);
        }
        finish();
      } catch {
        showError();
      }
    };

    const send = () => {
      const q = input.value.trim();
      if (!q || busy) return;
      appendUser(q);
      input.value = '';
      // Thinking transition is SYNCHRONOUS — set before any await so the state is
      // observable the instant after submit (e2e relies on this).
      busy = true;
      input.disabled = true;
      sendBtn.disabled = true;
      body.append(cloneTpl(tplThink));
      panel.dataset.state = 'thinking';
      setMarks(true);
      scrollToEnd();
      void ask(q);
    };

    launcher.addEventListener('click', () => {
      if (isOpen()) close();
      else {
        askScope = null; // the corner launcher is corpus-wide
        open();
      }
    });
    closeBtn.addEventListener('click', close);
    sendBtn.addEventListener('click', send);
    // The composer is a div, not a <form> (avoids a duplicate landmark / the W-2
    // no-backend-form check on every page) — wire Enter explicitly.
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        send();
      }
    });

    // No scrim (D3): close on Escape or a click outside the dock. The outside
    // check is against `root` (the dock wrapping launcher + panel), NOT the
    // panel — else the opening click on the sibling launcher self-closes it.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) close();
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && e.target instanceof Node && !root.contains(e.target))
        close();
    });

    // Per-article "ask about this article" entry points (ArticleAskButton). A
    // delegated, CAPTURE-phase listener: it runs BEFORE the bubble-phase
    // outside-click closer above, and stopPropagation keeps that closer from
    // firing on the (out-of-dock) trigger. Opens the existing panel, SCOPES the
    // session to the trigger's article (data-avatar-scope -> scopeSlug), and
    // pre-fills the composer with the build-time seed.
    document.addEventListener(
      'click',
      (e) => {
        const trigger =
          e.target instanceof Element
            ? e.target.closest('[data-avatar-ask]')
            : null;
        if (!(trigger instanceof HTMLElement)) return;
        e.stopPropagation();
        askScope = trigger.dataset.avatarScope ?? null;
        if (!isOpen()) open();
        input.value = trigger.dataset.avatarSeed ?? '';
        input.focus();
      },
      true
    );
  }
</script>
