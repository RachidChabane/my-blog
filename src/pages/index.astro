---
import { DEFAULT_LOCALE, localePath } from '@/i18n/index';

const defaultHref = localePath(DEFAULT_LOCALE);
---

<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        var locales = ['fr', 'en'];
        var lang =
          (navigator.languages && navigator.languages[0]) ||
          navigator.language ||
          '';
        lang = lang.toLowerCase();
        for (var i = 0; i < locales.length; i++) {
          if (lang === locales[i] || lang.startsWith(locales[i] + '-')) {
            if (locales[i] !== 'fr') {
              window.location.replace('/' + locales[i] + '/');
              return;
            }
            break;
          }
        }
        window.location.replace('/fr/');
      })();
    </script>
    <meta http-equiv="refresh" content={`0;url=${defaultHref}`} />
    <link rel="canonical" href={defaultHref} />
  </head>
  <body></body>
</html>
