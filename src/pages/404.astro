---
/** Not found outside a locale: the same page as the default locale's. */
import Office from '@/layouts/Office.astro';
import { DEFAULT_LOCALE, localePath } from '@/i18n/index';
import { who } from '@/office/draw';
import { officeStrings } from '@/office/strings';

const lang = DEFAULT_LOCALE;
const t = officeStrings(lang);
---

<Office
  title="404 · Rachid Chabane"
  description={t.notFound.title}
  lang={lang}
  noindex
>
  <div class="wrap page">
    <article class="sheet lost" style="--tape:var(--ctrl)">
      <div class="guards">
        <Fragment set:html={who('Verrou', 'd2')} />
        <Fragment set:html={who('Cadenas', 'd3')} />
      </div>
      <h1>{t.notFound.title}</h1>
      <p>{t.notFound.body}</p>
      <a class="pill go" href={localePath(lang)}>{t.notFound.home}</a>
    </article>
  </div>
</Office>
