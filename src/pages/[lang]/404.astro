---
/** Not found, per locale: the two guards at the door, and the way back. */
import type { GetStaticPaths } from 'astro';
import { LOCALES, localePath } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import Office from '@/layouts/Office.astro';
import { who } from '@/office/draw';
import { officeStrings } from '@/office/strings';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const t = officeStrings(lang);
---

<Office
  title={`404 · Rachid Chabane`}
  description={t.notFound.title}
  lang={lang}
  noindex
>
  <div class="wrap page">
    <article class="sheet lost" style="--tape:var(--ctrl)">
      <div class="guards">
        <Fragment set:html={who('Verrou', 'd2')} />
        <Fragment set:html={who('Cadenas', 'd3')} />
      </div>
      <h1>{t.notFound.title}</h1>
      <p>{t.notFound.body}</p>
      <a class="pill go" href={localePath(lang)}>{t.notFound.home}</a>
    </article>
  </div>
</Office>
