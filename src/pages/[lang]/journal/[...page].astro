---
/**
 * Journal index. `/[lang]/journal/` on a `[...page]` rest route (same shape as the
 * radar index: one path per locale). A FLAT newest-first list of the owner's dated
 * idea pieces; with no published piece the page renders the intro and an empty line.
 * Ordering + view-models come from src/lib/content.ts (getPublishedJournal,
 * toJournalCard); the frame is the shared SectionIndex, the rows the shared
 * DatedListItem. No slugMap on the index → the language switcher falls back to the
 * localized home (both /fr/journal/ and /en/journal/ exist).
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { LOCALES } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import { journalIndexStrings, articleIndexStrings } from '@/i18n/ui';
import { getPublishedJournal, toJournalCard } from '@/lib/content';
import type { DatedCard } from '@/lib/content';
import Base from '@/layouts/Base.astro';
import DatedListItem from '@/components/DatedListItem.astro';
import SectionIndex from '@/components/SectionIndex.astro';

export const getStaticPaths = (async () => {
  const [journal, tagEntries] = await Promise.all([
    getCollection('journal'),
    getCollection('tags'),
  ]);
  const tags = tagEntries.map((t: CollectionEntry<'tags'>) => t.data);
  return LOCALES.map((lang) => ({
    params: { lang, page: undefined },
    props: {
      lang,
      cards: getPublishedJournal(journal, lang).map((e) =>
        toJournalCard(e, lang, tags)
      ),
    },
  }));
}) satisfies GetStaticPaths;

const { lang, cards } = Astro.props as { lang: Locale; cards: DatedCard[] };
const s = journalIndexStrings(lang);
const readCta = articleIndexStrings(lang).readCta;
const title = `${s.title} · rachid chabane`;
---

<Base title={title} description={s.intro} lang={lang} switchSection="journal">
  <SectionIndex
    title={s.title}
    intro={s.intro}
    count={cards.length}
    emptyNote={s.empty}
  >
    {
      cards.map((card) => (
        <DatedListItem card={card} readCta={readCta} emphasizeDate reveal />
      ))
    }
  </SectionIndex>
</Base>
