---
/** A journal piece: a dated idea, read without sources or question box. */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { LOCALES, switcherHref } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import {
  buildJournalSlugMap,
  getPublishedJournal,
  readingTime,
  toIsoDate,
} from '@/lib/content';
import Office from '@/layouts/Office.astro';
import Reading from '@/components/office/Reading.astro';
import { NEXT_COUNT, journalRow, shortDek } from '@/office/view';
import type { Row } from '@/office/view';

export const getStaticPaths = (async () => {
  const journal = await getCollection('journal');
  return LOCALES.flatMap((lang) => {
    const published = getPublishedJournal(journal, lang);
    return published.map((entry, i) => ({
      params: { lang, slug: entry.data.slug },
      props: {
        lang,
        entry,
        slugMap: buildJournalSlugMap(journal, entry.data.translationKey),
        next: published
          .filter((_, n) => n !== i)
          .slice(0, NEXT_COUNT)
          .map((e) => journalRow(e, lang)),
      },
    }));
  });
}) satisfies GetStaticPaths;

const { lang, entry, slugMap, next } = Astro.props as {
  lang: Locale;
  entry: CollectionEntry<'journal'>;
  slugMap: Partial<Record<Locale, string>>;
  next: Row[];
};
const { Content } = await render(entry);
const d = entry.data;
const description = shortDek(d.summary, 170);
const words = (entry.body ?? '').split(/\s+/).length;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description,
  datePublished: toIsoDate(d.publishDate),
  inLanguage: lang,
  author: { '@type': 'Person', name: 'Rachid Chabane' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Office
  title={`${d.title} · Journal · Rachid Chabane`}
  description={description}
  lang={lang}
  section="journal"
  altHref={switcherHref(lang === 'fr' ? 'en' : 'fr', slugMap, 'journal')}
  reading
  words={words}
  ogType="article"
  jsonLd={jsonLd}
>
  <Reading
    lang={lang}
    section="journal"
    title={d.title}
    date={d.publishDate}
    minutes={readingTime(entry.body)}
    lede={d.summary}
    next={next}
  >
    <Content />
  </Reading>
</Office>
