---
/** A project: its scene, what it is, its figures, and its screenshots. */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { LOCALES, localePath } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import { getPublishedProjects } from '@/lib/content';
import type { ProjectFrontmatter } from '@/content/schemas';
import Office from '@/layouts/Office.astro';
import { projectScene } from '@/office/draw';
import { officeStrings } from '@/office/strings';
import { OTHERS_COUNT, shortDek } from '@/office/view';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return LOCALES.flatMap((lang) => {
    const published = getPublishedProjects(projects, lang);
    const otherLang: Locale = lang === 'fr' ? 'en' : 'fr';
    return published.map((entry, i) => {
      const twin = getPublishedProjects(projects, otherLang).find(
        (p) => p.data.translationKey === entry.data.translationKey
      );
      return {
        params: { lang, slug: entry.data.slug },
        props: {
          lang,
          entry,
          altHref: twin
            ? localePath(otherLang, `work/${twin.data.slug}`)
            : localePath(otherLang, 'work/'),
          others: published
            .filter((_, n) => n !== i)
            .slice(0, OTHERS_COUNT)
            .map((p) => ({
              href: localePath(lang, `work/${p.data.slug}`),
              name: p.data.name.split(':')[0].trim(),
              year: p.data.year ?? '',
            })),
        },
      };
    });
  });
}) satisfies GetStaticPaths;

const { lang, entry, altHref, others } = Astro.props as {
  lang: Locale;
  entry: CollectionEntry<'projects'>;
  altHref: string;
  others: { href: string; name: string; year: string }[];
};
const t = officeStrings(lang);
const { Content } = await render(entry);
const d: ProjectFrontmatter = entry.data;
const [rawName, ...rest] = d.name.split(':');
const name = rawName.trim();
const sub = rest.join(':').trim();
const description = shortDek(d.summary, 170);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name,
  description,
  inLanguage: lang,
  programmingLanguage: d.stack,
  author: { '@type': 'Person', name: 'Rachid Chabane' },
  codeRepository: d.links[0]?.url,
};
---

<Office
  title={`${name} · ${t.sections.work} · Rachid Chabane`}
  description={description}
  lang={lang}
  section="work"
  altHref={altHref}
  reading
  jsonLd={jsonLd}
>
  <div class="wrap page">
    <div class="pscene big" set:html={projectScene(d.translationKey, name)} />
    <article class="sheet" style="--tape:var(--ctrl)">
      <div class="phead">
        <div class="kicker">
          <a href={localePath(lang, 'work/')}>{t.sections.work}</a>
          {d.year && <span>{d.year}</span>}
          <span>{d.status}</span>
        </div>
        <h1>{name}</h1>
        {sub && <div class="sub">{sub}</div>}
      </div>
      <div class="pgrid">
        <div class="prose">
          <p>{d.summary}</p>
          <Content />
        </div>
        <div class="pside">
          {
            d.metrics && (
              <div class="metrics">
                {d.metrics.map((m) => (
                  <div>
                    <b>{m.value}</b>
                    <span>{m.label}</span>
                  </div>
                ))}
              </div>
            )
          }
          {
            d.highlights && (
              <ul class="hl">
                {d.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )
          }
          <div class="stack">
            {d.stack.map((x) => <span>{x}</span>)}
          </div>
          {
            d.architecture && (
              <div class="layers">
                {d.architecture.layers.map((l) => (
                  <div>
                    <b>{l.label}</b>
                    {l.nodes.map((n) => (
                      <span class="chip" style="--c:var(--arch)">
                        {n}
                      </span>
                    ))}
                  </div>
                ))}
              </div>
            )
          }
          <p class="plinks">
            {d.links.map((l) => <a href={l.url}>{l.label}</a>)}
          </p>
        </div>
      </div>
    </article>
    {
      d.gallery && (
        <div class="shots">
          {d.gallery.map((g, i) => (
            <figure>
              <button
                type="button"
                data-shot={g.src}
                data-caption={g.caption ?? g.alt}
                style={`--r:${((i % 3) - 1) * 0.8}deg`}
                aria-label={t.project.enlarge}
              >
                <img src={g.src} alt={g.alt} loading="lazy" />
              </button>
              <figcaption>{g.caption ?? ''}</figcaption>
            </figure>
          ))}
        </div>
      )
    }
    <nav class="others" aria-label={t.project.others}>
      {
        others.map((o) => (
          <a href={o.href}>
            <span class="mono">{o.year}</span>
            <b>{o.name}</b>
          </a>
        ))
      }
    </nav>
  </div>
</Office>
