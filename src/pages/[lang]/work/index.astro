---
/** The projects stand: one folder per project, each with its own scene. */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { LOCALES, localePath } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import { getPublishedProjects } from '@/lib/content';
import Office from '@/layouts/Office.astro';
import Room from '@/components/office/Room.astro';
import { crew, projectScene } from '@/office/draw';
import { officeStrings } from '@/office/strings';
import { shortDek } from '@/office/view';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const t = officeStrings(lang);
const projects = getPublishedProjects(await getCollection('projects'), lang);
const TABS = ['var(--art)', 'var(--clawd)', '#BFE0FF', '#C9C2F0', '#BFE6D6'];
const description =
  lang === 'fr'
    ? 'Les projets de Rachid Chabane : outils pour agents de code, plateformes RAG, logiciels open source.'
    : 'Rachid Chabane’s projects: tools for coding agents, RAG platforms, open-source software.';
---

<Office
  title={`${t.sections.work} · Rachid Chabane`}
  description={description}
  lang={lang}
  section="work"
  altHref={localePath(lang === 'fr' ? 'en' : 'fr', 'work/')}
>
  <Room
    section="work"
    title={t.sections.work}
    count={t.counts.projects(projects.length)}
    crew={crew('work')}
  />
  <div class="wrap page">
    <div class="cards">
      {
        projects.map((p, i) => {
          const [name, ...rest] = p.data.name.split(':');
          const sub = rest.join(':').trim();
          return (
            <a
              class="folder"
              href={localePath(lang, `work/${p.data.slug}`)}
              data-y={[p.data.year, p.data.status].filter(Boolean).join(' · ')}
              style={`--tab:${TABS[i % TABS.length]}`}
            >
              <div
                class="pscene inset"
                set:html={projectScene(p.data.translationKey, name.trim())}
              />
              <h3>{name.trim()}</h3>
              {sub && <div class="sub">{sub}</div>}
              <p>{shortDek(p.data.summary, 170)}</p>
            </a>
          );
        })
      }
    </div>
  </div>
</Office>
