---
/** About: who writes, a framed portrait on the wall, and the team of Clawds. */
import type { GetStaticPaths } from 'astro';
import { LOCALES, localePath } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import { aboutStrings, CONTACTS } from '@/i18n/ui';
import Office from '@/layouts/Office.astro';
import Room from '@/components/office/Room.astro';
import { clawd, TEAM, who } from '@/office/draw';
import { officeStrings } from '@/office/strings';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const t = officeStrings(lang);
const s = aboutStrings(lang);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Rachid Chabane',
  url: new URL(localePath(lang, 'about/'), Astro.site).href,
  image: new URL('/profile.jpg', Astro.site).href,
  jobTitle: s.tagline,
  sameAs: CONTACTS.filter((c) => c.href?.startsWith('http')).map((c) => c.href),
};
---

<Office
  title={`${t.sections.about} · Rachid Chabane`}
  description={s.metaDesc}
  lang={lang}
  section="about"
  altHref={localePath(lang === 'fr' ? 'en' : 'fr', 'about/')}
  reading
  jsonLd={jsonLd}
>
  <Room
    section="about"
    title={t.sections.about}
    count={s.tagline}
    crew={who('Arrosoir', 'wave')}
  />
  <div class="wrap page">
    <article class="sheet" style="--tape:var(--clawd)">
      <div class="about">
        <div class="prose">
          <p>{s.bioP}</p>
          <h2>{s.howH}</h2>
          <p>{s.howText}</p>
          <h2>{s.contactH}</h2>
          <ul>
            {
              CONTACTS.filter((c) => c.href !== null).map((c) => (
                <li>
                  {c.label} : <a href={c.href}>{'value' in c ? c.value : ''}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <figure class="frame">
          <img
            src="/profile.jpg"
            alt={t.about.portrait}
            width="320"
            height="320"
          />
          <figcaption>Rachid</figcaption>
        </figure>
      </div>
      <h2 class="teamh">{t.about.team}</h2>
      <div class="team">
        {
          TEAM.map((m, i) => (
            <figure>
              <Fragment
                set:html={clawd({
                  wear: m.wear,
                  tint: m.tint,
                  cls: `d${(i % 3) + 1}`,
                  name: m.name,
                })}
              />
              <b>{m.name}</b>
              <span>{m.role[lang]}</span>
            </figure>
          ))
        }
      </div>
    </article>
  </div>
</Office>
