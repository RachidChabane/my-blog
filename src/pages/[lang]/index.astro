---
/** Home: the office in section, then the newest text of each stand. */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { LOCALES, localePath } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import { getPublishedProjects } from '@/lib/content';
import Office from '@/layouts/Office.astro';
import Rows from '@/components/office/Rows.astro';
import { frieze } from '@/office/draw';
import type { FriezeRoom } from '@/office/draw';
import { officeStrings, SECTION_PATHS } from '@/office/strings';
import { articleRows, journalRows, radarRows } from '@/office/view';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const t = officeStrings(lang);
const [articleEntries, radarEntries, journalEntries, projectEntries] =
  await Promise.all([
    getCollection('articles'),
    getCollection('radar'),
    getCollection('journal'),
    getCollection('projects'),
  ]);
const articles = articleRows(articleEntries, lang);
const radar = radarRows(radarEntries, lang);
const journal = journalRows(journalEntries, lang);
const projects = getPublishedProjects(projectEntries, lang);
const lead = articles[0];
const HOME_RADAR = 5;
const HOME_ARTICLES = 5;
const rooms: FriezeRoom[] = (
  ['radar', 'blog', 'work', 'library', 'journal'] as const
).map((key) => ({
  key,
  label: t.sections[key],
  href: localePath(lang, SECTION_PATHS[key]),
  say: t.frieze.say[key],
}));
const description =
  lang === 'fr'
    ? 'Ingénierie de l’IA : articles de fond, radar quotidien, journal et projets open source de Rachid Chabane.'
    : 'AI engineering: long-form articles, a daily radar, a journal and open-source projects by Rachid Chabane.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Rachid Chabane',
  url: new URL(localePath(lang), Astro.site).href,
  inLanguage: lang,
  author: { '@type': 'Person', name: 'Rachid Chabane' },
};
---

<Office
  title="Rachid Chabane · AI engineering"
  description={description}
  lang={lang}
  altHref={localePath(lang === 'fr' ? 'en' : 'fr')}
  jsonLd={jsonLd}
>
  <div class="pano" id="pano">
    <div class="strip">
      <Fragment set:html={frieze(rooms, t.frieze.aria)} />
      <div class="snaps"><i></i><i></i><i></i><i></i><i></i></div>
    </div>
  </div>
  <div class="wrap home">
    {
      lead && (
        <article class="sheet lead">
          <div class="kicker">
            <time>{lead.date}</time>
            <span>{lead.minutes} min</span>
            <span>
              {lead.sources} {t.sources.toLowerCase()}
            </span>
          </div>
          <h2>
            <a href={lead.href}>{lead.title}</a>
          </h2>
          <p>{lead.dek}</p>
          <a class="pill go" href={lead.href}>
            {t.read}
          </a>
        </article>
      )
    }
    <section class="board">
      <h3>{t.sections.radar}</h3>
      <ol>
        {
          radar.slice(0, HOME_RADAR).map((r) => (
            <li>
              <span class="mono">
                {r.date} · {t.kinds[r.kind] ?? r.kind}
              </span>
              <a href={r.href}>{r.title}</a>
            </li>
          ))
        }
      </ol>
      <a class="all" href={localePath(lang, SECTION_PATHS.radar)}>
        {t.counts.briefs(radar.length)}
      </a>
    </section>
    <section class="sheet more" style="--tape:var(--ctrl)">
      <h3>{t.sections.blog}</h3>
      <Rows rows={articles.slice(1, 1 + HOME_ARTICLES)} lang={lang} />
      <p class="allp">
        <a class="all" href={localePath(lang, SECTION_PATHS.blog)}>
          {t.counts.articles(articles.length)}
        </a>
      </p>
    </section>
    <div class="side">
      {
        journal[0] && (
          <section class="jr">
            <h3>{t.sections.journal}</h3>
            <a class="t" href={journal[0].href}>
              {journal[0].title}
            </a>
            <span class="mono">{journal[0].date}</span>
          </section>
        )
      }
      <section>
        <h3>{t.sections.work}</h3>
        <div class="proj">
          {
            projects.map((p) => (
              <a href={localePath(lang, `work/${p.data.slug}`)}>
                {p.data.name.split(':')[0].trim()}
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Office>
