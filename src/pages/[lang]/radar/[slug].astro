---
/** A radar brief: a short sourced text, read like an article. */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { LOCALES, switcherHref } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import {
  buildRadarSlugMap,
  getPublishedRadar,
  readingTime,
  toIsoDate,
  toSourceViews,
} from '@/lib/content';
import type { SourceView } from '@/lib/content';
import type { Provenance } from '@/content/schemas';
import Office from '@/layouts/Office.astro';
import Reading from '@/components/office/Reading.astro';
import type { Citation } from '@/components/office/Reading.astro';
import { officeStrings } from '@/office/strings';
import { NEXT_COUNT, radarRow, shortDek } from '@/office/view';
import type { Row } from '@/office/view';

export const getStaticPaths = (async () => {
  const [radar, provenance] = await Promise.all([
    getCollection('radar'),
    getCollection('provenance'),
  ]);
  return LOCALES.flatMap((lang) => {
    const published = getPublishedRadar(radar, lang);
    return published.map((entry, i) => {
      const prov = provenance.find(
        (p: CollectionEntry<'provenance'>) =>
          p.data.slug === entry.data.slug && p.data.lang === lang
      );
      const citations: Citation[] = (prov?.data.citations ?? []).map(
        (c: Provenance['citations'][number]) => ({
          n: c.sourceId.slice(1),
          label: c.label,
          url: c.url,
          excerpt: shortDek(c.excerpt, 260),
        })
      );
      const others = published.filter((_, n) => n !== i);
      const next = [...others.slice(i, i + NEXT_COUNT), ...others].slice(
        0,
        NEXT_COUNT
      );
      return {
        params: { lang, slug: entry.data.slug },
        props: {
          lang,
          entry,
          sources: toSourceViews(entry.data.sources),
          slugMap: buildRadarSlugMap(radar, entry.data.translationKey),
          citations,
          next: next.map((e) => radarRow(e, lang)),
        },
      };
    });
  });
}) satisfies GetStaticPaths;

const { lang, entry, sources, slugMap, citations, next } = Astro.props as {
  lang: Locale;
  entry: CollectionEntry<'radar'>;
  sources: SourceView[];
  slugMap: Partial<Record<Locale, string>>;
  citations: Citation[];
  next: Row[];
};
const t = officeStrings(lang);
const { Content } = await render(entry);
const d = entry.data;
const description = shortDek(d.summary, 170);
const words = (entry.body ?? '').split(/\s+/).length;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.title,
  description,
  datePublished: toIsoDate(d.publishDate),
  inLanguage: lang,
  keywords: d.tags.join(', '),
  author: { '@type': 'Person', name: 'Rachid Chabane' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  citation: sources.map((s) => s.url),
};
---

<Office
  title={`${d.title} · Radar · Rachid Chabane`}
  description={description}
  lang={lang}
  section="radar"
  altHref={switcherHref(lang === 'fr' ? 'en' : 'fr', slugMap, 'radar')}
  reading
  words={words}
  ogType="article"
  jsonLd={jsonLd}
>
  <Reading
    lang={lang}
    section="radar"
    title={d.title}
    date={d.publishDate}
    minutes={readingTime(entry.body)}
    kindLabel={t.kinds[d.kind] ?? d.kind}
    lede={shortDek(d.summary, 400)}
    sources={sources}
    citations={citations}
    next={next}
    slug={d.slug}
  >
    <Content />
  </Reading>
</Office>
