---
/** The training stand: the exam game, the certifications held, and the exam outline. */
import type { GetStaticPaths } from 'astro';
import { LOCALES, localePath } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import Office from '@/layouts/Office.astro';
import Room from '@/components/office/Room.astro';
import Game from '@/training/Game.astro';
import { crew } from '@/office/draw';
import { officeStrings } from '@/office/strings';
import { certificationRows, domainRows } from '@/office/drill';
import type { Certification, Exam } from '@/office/drill';
import certifications from '@/training/data/certifications.json';
import exam from '@/training/data/exam.json';
import questions from '@/training/data/questions.json';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const t = officeStrings(lang);
const d = t.drill;
const examData = exam as Exam;
const certs = certificationRows(certifications as Certification[], t.months);
const domains = domainRows(examData, questions, lang);
const totalWeight = domains.reduce((sum, row) => sum + row.weight, 0);
const percent = new Intl.NumberFormat(lang, { style: 'percent' });
const pct = (whole: number) => percent.format(whole / 100);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t.sections.training,
  description: d.description,
  inLanguage: lang,
  url: new URL(localePath(lang, 'training/'), Astro.site).href,
  about: {
    '@type': 'Person',
    name: 'Rachid Chabane',
    hasCredential: certs.map((c) => ({
      '@type': 'EducationalOccupationalCredential',
      name: c.title,
      recognizedBy: { '@type': 'Organization', name: c.issuer },
      dateCreated: c.datetime,
      ...(c.proof ? { url: c.proof.href } : {}),
    })),
  },
};
---

<Office
  title={`${t.sections.training} · Rachid Chabane`}
  description={d.description}
  lang={lang}
  section="training"
  altHref={localePath(lang === 'fr' ? 'en' : 'fr', 'training/')}
  jsonLd={jsonLd}
>
  <Room
    section="training"
    title={t.sections.training}
    count={d.count(questions.length, domains.length)}
    crew={crew('training')}
  />
  <div class="wrap page drill">
    <a class="playlink" href={`${localePath(lang, 'training/')}#play`}>
      {d.play}
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M6 4l14 8-14 8z" fill="currentColor"></path></svg
      >
    </a>
    <Game lang={lang}>
      <section class="sheet intro" style="--tape:var(--drill)">
        <p>{d.intro}</p>
        <p>{d.domainsLine(domains.length, examData.code)}</p>
      </section>
      <section
        class="sheet prose"
        style="--tape:var(--art)"
        aria-labelledby="certifications"
      >
        <h2 id="certifications">{d.certifications}</h2>
        <div
          class="tablewrap"
          tabindex="0"
          role="region"
          aria-labelledby="cert-caption"
        >
          <table class="certs">
            <caption id="cert-caption">{d.certCaption}</caption>
            <thead>
              <tr>
                <th scope="col">{d.certCols.title}</th>
                <th scope="col">{d.certCols.issuer}</th>
                <th scope="col">{d.certCols.date}</th>
                <th scope="col">{d.certCols.score}</th>
                <th scope="col">{d.certCols.proof}</th>
              </tr>
            </thead>
            <tbody>
              {
                certs.map((c) => (
                  <tr>
                    <th scope="row">{c.title}</th>
                    <td data-label={d.certCols.issuer}>{c.issuer}</td>
                    <td data-label={d.certCols.date}>
                      <time datetime={c.datetime}>{c.date}</time>
                    </td>
                    <td data-label={d.certCols.score}>{c.score}</td>
                    <td data-label={d.certCols.proof}>
                      {c.proof && (
                        <a href={c.proof.href} rel="noopener">
                          {d.proofLink(c.proof.host)}
                        </a>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
      <section
        class="sheet prose"
        style="--tape:var(--drill)"
        aria-labelledby="exam"
      >
        <h2 id="exam">{d.exam}</h2>
        <p class="format">
          <b>{examData.name}</b>
          <span>
            {
              d.format(
                examData.questionCount,
                examData.minutes,
                examData.passScore,
                examData.maxScore
              )
            }
          </span>
        </p>
        <div
          class="tablewrap"
          tabindex="0"
          role="region"
          aria-labelledby="exam-caption"
        >
          <table>
            <caption id="exam-caption">{d.examCaption(examData.code)}</caption>
            <thead>
              <tr>
                <th scope="col">{d.examCols.domain}</th>
                <th scope="col" class="num">{d.examCols.weight}</th>
                <th scope="col" class="num">{d.examCols.inGame}</th>
              </tr>
            </thead>
            <tbody>
              {
                domains.map((row) => (
                  <tr>
                    <th scope="row">{row.name}</th>
                    <td class="num">{pct(row.weight)}</td>
                    <td class="num">{row.questions}</td>
                  </tr>
                ))
              }
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">{d.total}</th>
                <td class="num">{pct(totalWeight)}</td>
                <td class="num">{questions.length}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>
    </Game>
  </div>
</Office>
