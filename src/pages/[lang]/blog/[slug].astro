---
/** An article: its sheet, its sources, the question box, what to read next. */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { LOCALES, switcherHref } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import {
  buildSlugMap,
  categoryLabel,
  excerpt,
  getPublishedArticles,
  readingTime,
  toIsoDate,
  toSourceViews,
} from '@/lib/content';
import type { SourceView } from '@/lib/content';
import type { Concept, Provenance } from '@/content/schemas';
import Office from '@/layouts/Office.astro';
import Reading from '@/components/office/Reading.astro';
import type { Citation, Term } from '@/components/office/Reading.astro';
import { NEXT_COUNT, articleRow, shortDek } from '@/office/view';
import type { Row } from '@/office/view';

export const getStaticPaths = (async () => {
  const [articles, provenance, categoryEntries, conceptEntries] =
    await Promise.all([
      getCollection('articles'),
      getCollection('provenance'),
      getCollection('categories'),
      getCollection('concepts'),
    ]);
  const categories = categoryEntries.map(
    (c: CollectionEntry<'categories'>) => c.data
  );
  const concepts: Concept[] = conceptEntries.map(
    (c: CollectionEntry<'concepts'>) => c.data as Concept
  );
  return LOCALES.flatMap((lang) => {
    const published = getPublishedArticles(articles, lang);
    return published.map((entry, i) => {
      const prov = provenance.find(
        (p: CollectionEntry<'provenance'>) =>
          p.data.slug === entry.data.slug && p.data.lang === lang
      );
      const citations: Citation[] = (prov?.data.citations ?? []).map(
        (c: Provenance['citations'][number]) => ({
          n: c.sourceId.slice(1),
          label: c.label,
          url: c.url,
          excerpt: shortDek(c.excerpt, 260),
        })
      );
      const terms: Term[] = concepts
        .filter((c) => c.articles.includes(entry.data.translationKey))
        .map((c) => ({
          id: c.id,
          term: c.label[lang],
          def: c.definition[lang],
        }));
      const others = published.filter((_, n) => n !== i);
      const next = [...others.slice(i, i + NEXT_COUNT), ...others].slice(
        0,
        NEXT_COUNT
      );
      return {
        params: { lang, slug: entry.data.slug },
        props: {
          lang,
          entry,
          sources: toSourceViews(entry.data.sources),
          slugMap: buildSlugMap(articles, entry.data.translationKey),
          kindLabel: categoryLabel(entry.data.category, lang, categories),
          citations,
          terms,
          next: next.map((e) => articleRow(e, lang)),
        },
      };
    });
  });
}) satisfies GetStaticPaths;

const { lang, entry, sources, slugMap, kindLabel, citations, terms, next } =
  Astro.props as {
    lang: Locale;
    entry: CollectionEntry<'articles'>;
    sources: SourceView[];
    slugMap: Partial<Record<Locale, string>>;
    kindLabel: string;
    citations: Citation[];
    terms: Term[];
    next: Row[];
  };
const { Content } = await render(entry);
const d = entry.data;
const description = shortDek(excerpt(entry.body, 400), 170);
const words = (entry.body ?? '').split(/\s+/).length;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description,
  datePublished: toIsoDate(d.publishDate),
  inLanguage: lang,
  wordCount: words,
  keywords: d.tags.join(', '),
  author: { '@type': 'Person', name: 'Rachid Chabane' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  citation: sources.map((s) => s.url),
};
---

<Office
  title={`${d.title} · Rachid Chabane`}
  description={description}
  lang={lang}
  section="blog"
  altHref={switcherHref(lang === 'fr' ? 'en' : 'fr', slugMap, 'blog')}
  reading
  words={words}
  ogType="article"
  jsonLd={jsonLd}
>
  <Reading
    lang={lang}
    section="blog"
    title={d.title}
    date={d.publishDate}
    minutes={readingTime(entry.body)}
    kindLabel={kindLabel}
    sources={sources}
    citations={citations}
    terms={terms}
    next={next}
    slug={d.slug}
  >
    <Content />
  </Reading>
</Office>
