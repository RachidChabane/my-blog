---
/**
 * S2 — Article index. `/[lang]/blog/` on a `[...page]` rest route. The route was
 * historically paginated (`/[lang]/blog/2/`, …); it now renders ALL published
 * articles on a SINGLE page, GROUPED BY the 3-way `category` taxonomy (Essays,
 * Explainers, Briefings — fixed CATEGORY_ORDER). Category sections do not compose
 * with pagination (a category would otherwise split across a page boundary, with a
 * duplicate heading), so paginate() was dropped: getStaticPaths now emits one path
 * per locale (`{ page: undefined }`), keeping `[...page].astro` valid for both
 * /fr/blog/ and /en/blog/. The rest route is still required — a rest segment cannot
 * be index.astro, and `[page].astro` would collide with task 8's `[slug].astro`.
 *
 * View-models + ordering come from src/lib/content.ts (getArticlesByCategory does
 * the published+lang filter and newest-first sort; the route maps each raw entry
 * through toArticleCard and resolves the localized category label). Copy from
 * src/i18n/ui.ts; chrome (masthead/footer/avatar/skip-link) from Base. No slugMap →
 * the language switcher falls back to the localized home (plan decision #6; NFR-11
 * holds since both /fr/blog/ and /en/blog/ exist).
 *
 * LANDMARK SAFETY: category groups are `<section aria-labelledby>` + `<h2>` only —
 * no new <header>/<nav>/<form>/<main>/<footer>. A named <section> is a `region`,
 * which the landmark-scoped a11y specs do not count (banner/main/contentinfo/nav).
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { LOCALES, localePath } from '@/i18n/index';
import type { Locale } from '@/i18n/index';
import { articleIndexStrings } from '@/i18n/ui';
import {
  getArticlesByCategory,
  toArticleCard,
  categoryLabel,
  tagRail,
} from '@/lib/content';
import type { ArticleCard, RailTag } from '@/lib/content';
import Base from '@/layouts/Base.astro';
import ArticleListItem from '@/components/ArticleListItem.astro';
import TagChips from '@/components/TagChips.astro';

/** One category section's rendered view-data: localized heading + its cards. */
interface CategorySection {
  category: string; // slug — feeds the stable section/heading id
  label: string; // localized category label (from the categories vocab)
  cards: ArticleCard[];
}

export const getStaticPaths = (async () => {
  const [articles, tagEntries, categoryEntries] = await Promise.all([
    getCollection('articles'),
    getCollection('tags'),
    getCollection('categories'),
  ]);
  const tags = tagEntries.map((t: CollectionEntry<'tags'>) => t.data);
  const categories = categoryEntries.map(
    (c: CollectionEntry<'categories'>) => c.data
  );
  return LOCALES.map((lang) => {
    const sections: CategorySection[] = getArticlesByCategory(
      articles,
      lang
    ).map((group) => ({
      category: group.category,
      label: categoryLabel(group.category, lang, categories),
      cards: group.articles.map((e) => toArticleCard(e, lang, tags)),
    }));
    const total = sections.reduce((n, s) => n + s.cards.length, 0);
    // `page: undefined` ⇒ the rest route emits the base path (/<lang>/blog/) only.
    return {
      params: { lang, page: undefined },
      props: { lang, sections, total, rail: tagRail(tags, lang) },
    };
  });
}) satisfies GetStaticPaths;

const { lang, sections, total, rail } = Astro.props as {
  lang: Locale;
  sections: CategorySection[];
  total: number;
  rail: RailTag[];
};
const s = articleIndexStrings(lang);
const blogBase = localePath(lang, 'blog'); // "/<lang>/blog/"
const title = `${s.title} · rachid chabane`;
---

<Base title={title} lang={lang}>
  <div class="rc-index rc-enter">
    <header class="rc-pagehd">
      <span class="t-eyebrow">{s.eyebrow}</span>
      <h1 class="rc-pagehd__title">{s.title}</h1>
      <span class="rc-pagehd__meta">{total} {s.countSuffix}</span>
    </header>

    <div class="rc-filterbar">
      <TagChips
        rail={rail}
        activeSlug={null}
        allHref={blogBase}
        allLabel={s.allTag}
        ariaLabel={s.filterAria}
      />
    </div>

    {
      sections.length > 0 ? (
        sections.map((section) => (
          <section
            class="rc-catsec"
            aria-labelledby={`rc-cat-${section.category}`}
          >
            <h2 class="rc-catsec__title" id={`rc-cat-${section.category}`}>
              {section.label}
            </h2>
            <div class="rc-arows">
              {section.cards.map((card) => (
                <ArticleListItem card={card} readCta={s.readCta} />
              ))}
            </div>
          </section>
        ))
      ) : (
        <p class="rc-empty-note">{s.empty}</p>
      )
    }
  </div>
</Base>

<style>
  /* Centered content column. Merges site.css .rc-main base + screens.css
     .rc-main.rc-index (824px). Base already provides <main>; this is just the
     inner column (no second <main>). Tokens only. */
  .rc-index {
    width: 100%;
    max-width: 824px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }
  @media (max-width: 720px) {
    .rc-index {
      padding-left: 22px;
      padding-right: 22px;
    }
  }

  .rc-pagehd {
    padding-top: 52px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rc-pagehd__title {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: var(--fraunces-head);
    font-size: var(--text-h1);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--fg);
  }
  .rc-pagehd__meta {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--fg-subtle);
  }

  .rc-filterbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 22px;
  }

  /* Category section: the localized <h2> heading + its article rows. The gap on
     .rc-index already spaces sections; the heading sits flush above its rows. */
  .rc-catsec {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .rc-catsec__title {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: var(--fraunces-sub);
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--fg);
  }

  .rc-arows {
    display: flex;
    flex-direction: column;
  }

  .rc-empty-note {
    margin: 0;
    padding: 48px 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-muted);
  }

  /* Translate-only entrance (no opacity fade) so content is never hidden if the
     animation is paused; prefers-reduced-motion neutralizes it via tokens.css. */
  .rc-enter {
    animation: rc-rise var(--dur-enter) var(--ease-out);
  }
  @keyframes rc-rise {
    from {
      transform: translateY(14px);
    }
    to {
      transform: none;
    }
  }
</style>
