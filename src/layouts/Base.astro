---
import '@/styles/tokens.css';
import '@/styles/global.css';
import Masthead from '@/components/Masthead.astro';
import Footer from '@/components/Footer.astro';
import AvatarLauncher from '@/components/AvatarLauncher.astro';
import { themeInitScript } from '@/lib/theme';
import { chrome } from '@/i18n/ui';
import type { Locale } from '@/i18n/index';

export interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  translationKey?: string | null;
  slugMap?: Partial<Record<Locale, string>>;
}

const {
  title,
  description = 'Rachid Chabane — AI engineering blog & portfolio',
  lang = 'fr',
  slugMap,
} = Astro.props;
const c = chrome(lang);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={themeInitScript} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">{c.skipToContent}</a>
    <Masthead lang={lang} slugMap={slugMap} />
    <main id="main"><slot /></main>
    <Footer lang={lang} slugMap={slugMap} />
    <AvatarLauncher />
  </body>
</html>
