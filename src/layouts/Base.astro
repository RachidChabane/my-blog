---
export interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  description = 'Rachid Chabane — AI engineering blog & portfolio',
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <a href={`/${lang}/`}>Rachid Chabane</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Rachid Chabane</p>
    </footer>
  </body>
</html>
