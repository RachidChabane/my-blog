---
import '@/styles/tokens.css';
import '@/styles/global.css';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { themeInitScript } from '@/lib/theme';
import { LOCALES, switcherHref } from '@/i18n/index';
import type { Locale } from '@/i18n/index';

export interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  translationKey?: string | null;
  slugMap?: Partial<Record<Locale, string>>;
}

const {
  title,
  description = 'Rachid Chabane — AI engineering blog & portfolio',
  lang = 'fr',
  slugMap,
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={themeInitScript} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <a href={`/${lang}/`}>Rachid Chabane</a>
        <span aria-label="Language switcher">
          {
            LOCALES.map((locale) => (
              <a
                href={switcherHref(locale, slugMap)}
                aria-current={locale === lang ? 'true' : undefined}
                lang={locale}
              >
                {locale.toUpperCase()}
              </a>
            ))
          }
        </span>
      </nav>
      <ThemeToggle />
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Rachid Chabane</p>
    </footer>
  </body>
</html>
