---
import '@/styles/tokens.css';
import '@/styles/global.css';
import Masthead from '@/components/Masthead.astro';
import Footer from '@/components/Footer.astro';
import Avatar from '@/components/Avatar.astro';
import { themeInitScript } from '@/lib/theme';
import { revealInitScript } from '@/lib/reveal';
import { chrome } from '@/i18n/ui';
import type { Locale } from '@/i18n/index';

export interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  translationKey?: string | null;
  slugMap?: Partial<Record<Locale, string>>;
  // Section the slugMap lives under, for the language switcher ('blog' default;
  // 'radar' on radar detail pages). Forwarded to Masthead + Footer switchers.
  switchSection?: string;
}

const {
  title,
  description = 'Rachid Chabane · AI engineering blog & portfolio',
  lang = 'fr',
  slugMap,
  switchSection,
} = Astro.props;
const c = chrome(lang);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={themeInitScript} />
    <script is:inline set:html={revealInitScript} />
    {
      /* The two faces that lay out the page: Fraunces sets the <h1> (the LCP
         element on most pages) and Inter sets the body copy. Without a preload
         the browser only discovers them once it has parsed the stylesheet AND
         laid out the text that needs them, so the fallback→webfont swap landed
         after first paint and reflowed the heading (the site's entire CLS).
         `crossorigin` is mandatory on font preloads even same-origin — fonts are
         fetched in CORS mode, and omitting it makes the browser fetch twice.
         The italic faces and JetBrains Mono are deliberately NOT preloaded: they
         are either absent above the fold or set type too small to shift layout. */
    }
    <link
      rel="preload"
      href="/fonts/Fraunces-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Inter-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === 'fr' ? 'Flux RSS' : 'RSS Feed'}
      href={`/${lang}/rss.xml`}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{c.skipToContent}</a>
    <Masthead lang={lang} slugMap={slugMap} switchSection={switchSection} />
    <main id="main"><slot /></main>
    <Footer lang={lang} slugMap={slugMap} switchSection={switchSection} />
    <Avatar lang={lang} />
  </body>
</html>
